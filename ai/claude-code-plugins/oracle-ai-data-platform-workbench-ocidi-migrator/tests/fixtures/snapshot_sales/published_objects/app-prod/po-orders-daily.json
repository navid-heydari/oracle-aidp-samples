                  "expr": {
                    "modelType": "EXPRESSION",
                    "key": "en-net-x",
                    "exprString": "ROUND(NVL(LOOKUP_PROD.ORDERS.AMOUNT, 0) * (1 - $P_DISCOUNT), 2)"
                  }
